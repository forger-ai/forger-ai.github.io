---
import type { CollectionEntry } from 'astro:content';
import {
  ArrowRight,
  Blocks,
  Bot,
  Check,
  Cloud,
  Code2,
  Download,
  HardDrive,
  LockKeyhole,
  MessageSquare,
  ShieldCheck,
  Sparkles,
} from 'lucide-astro';
import AppCatalogCard from './AppCatalogCard.astro';
import ChatDemo from './ChatDemo.astro';
import DesktopMockup from './DesktopMockup.astro';
import DownloadPicker from './DownloadPicker.astro';
import { apps } from '../data/apps';
import { localePath, t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  posts: CollectionEntry<'blog'>[];
}

const { lang, posts } = Astro.props;
const i18n = t(lang);

const featureIcons = [Blocks, HardDrive, Bot];
const workflowIcons = [Download, MessageSquare, Sparkles];
const trustIcons = [LockKeyhole, ShieldCheck, Code2];
---

<div class="overflow-hidden">
  <section class="relative px-6 pb-20 pt-24 sm:pt-28">
    <div class="orbital-field absolute inset-x-0 top-0 -z-10 h-[780px] opacity-80"></div>
    <div class="mx-auto max-w-6xl text-center">
      <div class="mx-auto max-w-4xl">
        <div class="animate-fade-up mb-6 flex flex-wrap justify-center gap-2">
          {i18n.home.hero.badges.map((badge) => (
            <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs font-medium text-zinc-300">{badge}</span>
          ))}
        </div>
        <h1 class="animate-fade-up text-5xl font-bold leading-[1.04] tracking-tight text-white sm:text-7xl lg:text-8xl">
          {i18n.home.hero.title1}<br />
          <span class="text-brand">{i18n.home.hero.title2}</span>
        </h1>
        <p class="animate-fade-up delay-200 mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-zinc-300">
          {i18n.home.hero.subtitle}
        </p>
        <div id="download" class="animate-fade-up delay-300 relative z-[80] mt-9 flex flex-col justify-center gap-3 sm:flex-row">
          <DownloadPicker lang={lang} />
          <a
            href="#apps"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-white/10 bg-white/[0.035] px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-brand/40 hover:bg-white/[0.06]"
          >
            {i18n.home.hero.ctaSecondary}
            <ArrowRight size={17} />
          </a>
        </div>
        <p class="animate-fade-up delay-400 mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-zinc-500">
          {i18n.home.hero.betaNote}
        </p>
        <div class="animate-fade-up delay-400 mt-5 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-sm text-zinc-500">
          <a href={localePath(lang, '/blog')} class="hover:text-zinc-300">{i18n.home.hero.blog}</a>
        </div>
      </div>

      <div class="mx-auto mt-14 max-w-6xl">
        <DesktopMockup lang={lang} />
      </div>
    </div>
  </section>

  <section id="customize" class="mx-auto max-w-6xl px-6 py-20">
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">{i18n.home.chat.eyebrow}</p>
      <h2 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-5xl">{i18n.home.chat.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-zinc-400">{i18n.home.chat.body}</p>
    </div>
    <ChatDemo lang={lang} />
    <p class="mx-auto mt-10 max-w-3xl text-center text-sm leading-relaxed text-zinc-500">
      {i18n.home.chat.privacyNote}
    </p>
  </section>

  <section id="what" class="mx-auto max-w-6xl px-6 py-20">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">{i18n.home.what.eyebrow}</p>
      <h2 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-5xl">{i18n.home.what.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-zinc-400">{i18n.home.what.body}</p>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {i18n.home.what.points.map((point, index) => {
        const Icon = featureIcons[index];
        return (
          <div class="rounded-[1.35rem] border border-white/10 bg-surface-raised/70 p-6">
            <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-2xl bg-brand/10 text-brand">
              <Icon size={21} />
            </div>
            <h3 class="text-lg font-semibold text-white">{point.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-zinc-400">{point.body}</p>
          </div>
        );
      })}
    </div>
  </section>

  <section id="how" class="mx-auto max-w-6xl px-6 py-20">
    <div class="rounded-[2rem] border border-white/10 bg-white/[0.03] p-6 sm:p-10">
      <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">{i18n.home.how.eyebrow}</p>
          <h2 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl">{i18n.home.how.title}</h2>
          <p class="mt-4 leading-relaxed text-zinc-400">{i18n.home.how.body}</p>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {i18n.home.how.steps.map((step, index) => {
            const Icon = workflowIcons[index];
            return (
              <div class="relative rounded-2xl border border-white/10 bg-zinc-950/55 p-5">
                <div class="pulse-line absolute -right-4 top-10 hidden h-px w-8 bg-brand/40 md:block"></div>
                <div class="mb-8 flex h-11 w-11 items-center justify-center rounded-2xl bg-brand/10 text-brand">
                  <Icon size={20} />
                </div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-zinc-500">{String(index + 1).padStart(2, '0')}</p>
                <h3 class="mt-2 font-semibold text-white">{step.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-zinc-400">{step.body}</p>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <section id="apps" class="mx-auto max-w-6xl px-6 py-20">
    <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">{i18n.home.apps.eyebrow}</p>
        <h2 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl">{i18n.home.apps.title}</h2>
        <p class="mt-4 leading-relaxed text-zinc-400">{i18n.home.apps.body}</p>
      </div>
    </div>
    <div class="grid gap-5 lg:grid-cols-[1.2fr_0.8fr]">
      <AppCatalogCard app={apps[0]} lang={lang} cta={i18n.home.apps.cardCta} statusLabel={i18n.home.apps.available} />
      <div class="rounded-[1.5rem] border border-white/10 bg-surface-raised/70 p-6">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-zinc-500">{i18n.home.apps.nextLabel}</p>
        <h3 class="mt-4 text-2xl font-semibold text-white">{i18n.home.apps.nextTitle}</h3>
        <p class="mt-3 text-sm leading-relaxed text-zinc-400">{i18n.home.apps.nextBody}</p>
        <div class="mt-8 space-y-3">
          {i18n.home.apps.future.map((item) => (
            <div class="flex items-center justify-between rounded-2xl border border-white/10 bg-zinc-950/40 px-4 py-3">
              <span class="text-sm text-zinc-300">{item}</span>
              <span class="h-2 w-2 rounded-full bg-brand/70"></span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="privacy" class="mx-auto max-w-6xl px-6 py-20">
    <div class="grid gap-5 md:grid-cols-3">
      {i18n.home.trust.cards.map((card, index) => {
        const Icon = trustIcons[index];
        return (
          <div class="rounded-[1.5rem] border border-white/10 bg-surface-raised/70 p-6">
            <div class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl bg-brand/10 text-brand">
              <Icon size={22} />
            </div>
            <h2 class="text-xl font-semibold text-white">{card.title}</h2>
            <p class="mt-4 text-sm leading-relaxed text-zinc-400">{card.body}</p>
          </div>
        );
      })}
    </div>
  </section>

  <section id="cloud" class="mx-auto max-w-6xl px-6 py-20">
    <div class="grid gap-10 rounded-[2rem] border border-brand/20 bg-brand/5 p-6 sm:p-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">{i18n.home.cloud.eyebrow}</p>
        <h2 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl">{i18n.home.cloud.title}</h2>
        <p class="mt-4 leading-relaxed text-zinc-300">{i18n.home.cloud.body}</p>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {i18n.home.cloud.items.map((item) => (
          <div class="rounded-2xl border border-white/10 bg-zinc-950/45 p-4">
            <Cloud class="text-brand" size={19} />
            <p class="mt-4 text-sm font-semibold text-white">{item.title}</p>
            <p class="mt-2 text-xs leading-relaxed text-zinc-500">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="beta" class="mx-auto max-w-6xl px-6 py-20">
    <div class="rounded-[2rem] border border-white/10 bg-surface-raised/70 p-6 sm:p-10">
      <span class="inline-block rounded-md bg-brand/15 px-2.5 py-1 text-xs font-medium uppercase tracking-wide text-brand">
        {i18n.home.beta.tag}
      </span>
      <h2 class="mt-4 max-w-2xl text-2xl font-bold leading-snug text-white">{i18n.home.beta.title}</h2>
      <p class="mt-3 max-w-3xl leading-relaxed text-zinc-400">{i18n.home.beta.body}</p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {i18n.home.beta.items.map((item) => (
          <li class="flex items-center gap-3 text-sm text-zinc-300">
            <Check size={15} class="shrink-0 text-brand" />
            {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 py-20">
      <h2 class="mb-8 text-2xl font-bold text-white">{i18n.home.fromBlog}</h2>
      <div class="grid gap-6 sm:grid-cols-3">
        {posts.map((post) => (
          <a
            href={`${localePath(lang, '/blog')}/${post.id.replace(new RegExp(`^${lang}/`), '')}`}
            class="group rounded-[1.35rem] border border-white/10 bg-surface-raised/70 p-6 transition-colors hover:bg-surface-overlay"
          >
            <time class="text-xs text-zinc-500">
              {post.data.pubDate.toLocaleDateString(lang === 'es' ? 'es-CL' : 'en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
            <h3 class="mt-2 font-semibold leading-snug text-white transition-colors group-hover:text-brand">{post.data.title}</h3>
            <p class="mt-2 line-clamp-2 text-sm text-zinc-400">{post.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="mx-auto max-w-4xl px-6 py-24 text-center">
    <h2 class="text-3xl font-bold leading-tight text-white sm:text-5xl">{i18n.home.finalCta.title}</h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-zinc-400">{i18n.home.finalCta.body}</p>
    <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
      <DownloadPicker lang={lang} />
      <a href="#apps" class="inline-flex items-center justify-center gap-2 rounded-full border border-white/10 bg-white/[0.035] px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-brand/40">
        {i18n.home.finalCta.secondary}
        <ArrowRight size={17} />
      </a>
    </div>
  </section>
</div>
