---
import ScreenshotFrame from './ScreenshotFrame.astro';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  en: {
    alt: 'Forger Desktop showing a local app workspace with Finance OS.',
  },
  es: {
    alt: 'Forger Desktop mostrando un espacio local de apps con Finance OS.',
  },
}[lang];
---

<ScreenshotFrame
  src="/assets/screenshots/forger-catalog.png"
  alt={copy.alt}
  class="animate-fade-up delay-300"
/>
