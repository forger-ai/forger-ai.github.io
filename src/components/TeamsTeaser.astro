---
import { AppWindow, ArrowUpRight, Cloud, ShieldCheck } from 'lucide-astro';
import { localePath, t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = t(lang).home.teamsTeaser;
const teamsPath = localePath(lang, '/teams');
const icons = [AppWindow, Cloud, ShieldCheck];
---

<section id="teams-preview" class="mx-auto max-w-6xl px-6 py-20">
  <div class="relative overflow-hidden rounded-[2rem] border border-brand/20 bg-brand/[0.05] p-6 sm:p-10">
    <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-brand/10 blur-3xl"></div>
    <div class="relative grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">{content.eyebrow}</p>
        <h2 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-5xl">{content.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-zinc-300">{content.body}</p>
        <a
          href={teamsPath}
          class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-xl bg-brand px-5 py-3 font-semibold text-black transition hover:bg-brand-dark"
        >
          {content.cta}
          <ArrowUpRight size={18} />
        </a>
      </div>
      <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
        {content.items.map((item, index) => {
          const Icon = icons[index];
          return (
            <div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-zinc-950/45 p-4">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand">
                <Icon size={19} />
              </span>
              <span class="text-sm font-semibold text-zinc-200">{item}</span>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
