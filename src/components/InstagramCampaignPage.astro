---
import {
  Check,
  Copy,
  Download,
  HardDrive,
  LockKeyhole,
  MonitorDown,
  Share2,
  ShieldCheck,
  Sparkles,
} from 'lucide-astro';
import DownloadPicker from './DownloadPicker.astro';
import ScreenshotFrame from './ScreenshotFrame.astro';
---

<div class="overflow-hidden">
  <section class="relative px-5 pb-12 pt-24 sm:px-6 sm:pt-28">
    <div class="orbital-field absolute inset-x-0 top-0 -z-10 h-[780px] opacity-80"></div>
    <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center">
      <div class="max-w-2xl">
        <p class="inline-flex items-center gap-2 rounded-full border border-brand/30 bg-brand/10 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-brand">
          <Sparkles size={14} aria-hidden="true" />
          Gratis para personas
        </p>
        <h1 class="mt-5 text-4xl font-bold leading-[1.04] tracking-tight text-white sm:text-6xl">
          Tu IA. Tus apps.<br />
          <span class="text-brand">Tu computador.</span>
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-zinc-300 sm:text-xl">
          Crea una app para tu vida o trabajo con la cuenta de IA que ya usas. Forger es gratis para personas y no cobra una suscripción adicional.
        </p>
        <ul class="mt-6 grid gap-3 text-sm text-zinc-300 sm:grid-cols-3">
          <li class="flex items-start gap-2"><Check class="mt-0.5 shrink-0 text-brand" size={17} aria-hidden="true" />ChatGPT, Claude o Antigravity</li>
          <li class="flex items-start gap-2"><Check class="mt-0.5 shrink-0 text-brand" size={17} aria-hidden="true" />Sin otro plan de Forger</li>
          <li class="flex items-start gap-2"><Check class="mt-0.5 shrink-0 text-brand" size={17} aria-hidden="true" />Local por defecto</li>
        </ul>
        <a href="#instalar" class="mt-8 inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-dark">
          <Download size={18} aria-hidden="true" />
          Descargar Forger gratis
        </a>
        <p class="mt-3 text-xs leading-relaxed text-zinc-500">No pedimos tarjeta. Los límites, condiciones y posibles costos de tu proveedor de IA siguen aplicando según la cuenta que ya tienes.</p>
      </div>

      <ScreenshotFrame
        src="/assets/screenshots/forger-new-experience.png"
        alt="Captura real de Forger Desktop mostrando una app local y el panel de conversación."
        label="Forger Desktop · captura real"
        class="mx-auto w-full max-w-3xl"
      />
    </div>
  </section>

  <section id="instalar" class="mx-auto max-w-5xl scroll-mt-24 px-5 py-12 sm:px-6 sm:py-20">
    <div class="rounded-[2rem] border border-brand/30 bg-brand/[0.08] p-5 shadow-2xl shadow-black/20 sm:p-9" data-campaign-handoff>
      <div class="grid gap-8 lg:grid-cols-[0.86fr_1.14fr] lg:items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">Instálalo donde crearás</p>
          <h2 class="mt-3 text-3xl font-bold leading-tight text-white sm:text-4xl">Forger se instala en tu computador.</h2>
          <p class="mt-4 leading-relaxed text-zinc-300">Si llegaste desde Instagram en tu teléfono, compártete este enlace. Al abrirlo en tu computador conservará la campaña y mostrará la descarga correcta.</p>
        </div>

        <div class="grid gap-4">
          <div class="rounded-2xl border border-white/10 bg-zinc-950/45 p-5" data-campaign-mobile-handoff>
            <div class="flex items-start gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand"><MonitorDown size={20} aria-hidden="true" /></div>
              <div>
                <h3 class="font-semibold text-white">¿Estás en tu teléfono?</h3>
                <p class="mt-1 text-sm leading-relaxed text-zinc-400">Envíate este enlace por el medio que prefieras y ábrelo desde tu computador.</p>
              </div>
            </div>
            <label class="sr-only" for="campaign-link">Enlace de descarga de Forger</label>
            <input id="campaign-link" data-campaign-link readonly class="mt-4 w-full rounded-xl border border-white/10 bg-white/[0.04] px-3 py-2 text-xs text-zinc-300 outline-none" value="forger.cloud/es/instagram" />
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
              <button type="button" data-campaign-share class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-brand px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-dark">
                <Share2 size={16} aria-hidden="true" /> Compartir enlace
              </button>
              <button type="button" data-campaign-copy class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-white/15 bg-white/[0.04] px-4 py-2.5 text-sm font-semibold text-zinc-100 transition-colors hover:bg-white/[0.08]">
                <Copy size={16} aria-hidden="true" /> Copiar enlace
              </button>
            </div>
            <p data-campaign-status class="mt-3 min-h-5 text-xs text-zinc-400" aria-live="polite"></p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-zinc-950/45 p-5" data-campaign-download>
            <div class="flex items-start gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand"><Download size={20} aria-hidden="true" /></div>
              <div>
                <h3 class="font-semibold text-white">¿Ya estás en tu computador?</h3>
                <p class="mt-1 text-sm leading-relaxed text-zinc-400">Elige una descarga. macOS Apple silicon es estable; las opciones para macOS Intel, Windows y Linux son experimentales.</p>
              </div>
            </div>
            <div class="mt-4"><DownloadPicker lang="es" /></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12 sm:px-6 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">Usa la IA que ya conoces</p>
        <h2 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl">No necesitas pagar otra suscripción.</h2>
        <p class="mt-5 text-lg leading-relaxed text-zinc-400">Conecta ChatGPT, Claude o Antigravity con la cuenta que ya tienes. Forger prepara el espacio para que puedas transformar una necesidad concreta en una app.</p>
        <p class="mt-4 text-sm leading-relaxed text-zinc-500">Forger no reemplaza el servicio de IA: cada proveedor mantiene sus propios límites, condiciones y posibles costos. Tú eliges la cuenta y el proveedor que quieres usar.</p>
      </div>
      <ScreenshotFrame
        src="/assets/screenshots/forger-catalog.png"
        alt="Captura real del catálogo local de apps disponibles en Forger."
        label="Explora apps dentro de Forger · captura real"
      />
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-12 sm:px-6 sm:py-20">
    <div class="grid gap-8 rounded-[2rem] border border-white/10 bg-white/[0.03] p-6 sm:p-10 lg:grid-cols-[0.88fr_1.12fr] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">Privado por diseño</p>
        <h2 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl">Tu espacio, bajo tu control.</h2>
        <p class="mt-5 text-lg leading-relaxed text-zinc-400">Las apps se instalan y corren en un workspace local de tu computador. Tú decides qué archivos usar y qué compartir.</p>
        <div class="mt-7 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl border border-white/10 bg-zinc-950/45 p-4">
            <HardDrive class="text-brand" size={20} aria-hidden="true" />
            <h3 class="mt-3 font-semibold text-white">Local primero</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">Las apps instaladas viven en tu computador y no deben leer archivos externos salvo que tú los compartas.</p>
          </div>
          <div class="rounded-2xl border border-white/10 bg-zinc-950/45 p-4">
            <LockKeyhole class="text-brand" size={20} aria-hidden="true" />
            <h3 class="mt-3 font-semibold text-white">Tú decides qué compartir</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">La nube se usa sólo si eliges funciones que la necesitan, como cuenta, respaldo o compartir.</p>
          </div>
        </div>
      </div>
      <ScreenshotFrame
        src="/assets/screenshots/forger-my-apps.png"
        alt="Captura real de Forger mostrando las apps instaladas en el computador de una persona."
        label="Tus apps en Forger · captura real"
      />
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-5 py-16 text-center sm:px-6 sm:py-24">
    <ShieldCheck class="mx-auto text-brand" size={30} aria-hidden="true" />
    <h2 class="mt-5 text-3xl font-bold leading-tight text-white sm:text-5xl">Crea una app que realmente te sirva.</h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-zinc-400">Gratis para personas. Usa la IA que ya tienes. Mantén tus apps en tu computador.</p>
    <a href="#instalar" class="mt-8 inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-brand px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-brand-dark">
      <Download size={18} aria-hidden="true" /> Descargar Forger gratis
    </a>
  </section>
</div>

<script is:inline>
  (() => {
    const handoff = document.querySelector('[data-campaign-handoff]');
    const linkInput = document.querySelector('[data-campaign-link]');
    const status = document.querySelector('[data-campaign-status]');
    const shareButton = document.querySelector('[data-campaign-share]');
    const copyButton = document.querySelector('[data-campaign-copy]');

    if (!handoff || !linkInput) return;

    function campaignUrl() {
      const url = new URL(window.location.href);
      for (const key of [...url.searchParams.keys()]) {
        if (!key.startsWith('utm_')) url.searchParams.delete(key);
      }
      if (!url.searchParams.has('utm_source')) url.searchParams.set('utm_source', 'instagram');
      return url.toString();
    }

    function setStatus(message) {
      if (status) status.textContent = message;
    }

    async function copyCampaignLink() {
      const url = campaignUrl();
      linkInput.value = url;

      try {
        await navigator.clipboard.writeText(url);
        setStatus('Enlace copiado. Ábrelo desde tu computador para descargar Forger.');
      } catch {
        linkInput.focus();
        linkInput.select();
        setStatus('Selecciona y copia este enlace para abrirlo en tu computador.');
      }
    }

    linkInput.value = campaignUrl();
    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    handoff.dataset.device = isMobile ? 'mobile' : 'desktop';

    copyButton?.addEventListener('click', copyCampaignLink);
    shareButton?.addEventListener('click', async () => {
      const url = campaignUrl();
      if (!navigator.share) {
        await copyCampaignLink();
        return;
      }

      try {
        await navigator.share({
          title: 'Forger gratis para personas',
          text: 'Crea apps locales con la IA que ya usas.',
          url,
        });
        setStatus('Listo: comparte el enlace y ábrelo desde tu computador.');
      } catch {
        setStatus('Puedes copiar el enlace y enviártelo por el medio que prefieras.');
      }
    });

    document.querySelectorAll('[data-campaign-download]').forEach((container) => {
      container.addEventListener('click', (event) => {
        const link = event.target.closest('a[href]');
        if (!link) return;

        const option = link.closest('[data-download-option]');
        const attributionUrl = new URL(campaignUrl());
        const utm = Object.fromEntries(attributionUrl.searchParams.entries());
        const intent = {
          campaign: 'instagram',
          action: 'download_intent',
          platform: option?.dataset.downloadOption || 'automatic',
          utm,
        };

        try {
          sessionStorage.setItem('forger-campaign-download-intent', JSON.stringify(intent));
        } catch {
          // This local handoff continues even when browser storage is unavailable.
        }

        window.dispatchEvent(new CustomEvent('forger:download-intent', { detail: intent }));
      });
    });
  })();
</script>
