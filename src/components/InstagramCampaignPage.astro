---
import {
  Check,
  Copy,
  Download,
  HardDrive,
  LockKeyhole,
  MonitorDown,
  Share2,
  ShieldCheck,
  Sparkles,
} from 'lucide-astro';
import DownloadPicker from './DownloadPicker.astro';
import ScreenshotFrame from './ScreenshotFrame.astro';
import type { Lang } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props as Props;

const copy = {
  en: {
    hero: {
      eyebrow: 'Free for people',
      title: ['Your AI. Your apps.', 'Your computer.'],
      description: 'Create an app for your life or work with the AI account you already use. Forger is free for people and does not charge an additional subscription.',
      points: ['ChatGPT, Claude, or Antigravity', 'No extra Forger plan', 'Local-first by default'],
      download: 'Download Forger free',
      note: 'No credit card required. The limits, terms, and possible costs of your AI provider still apply to the account you already have.',
      screenshotAlt: 'A real Forger Desktop screenshot showing a local app and the conversation panel.',
      screenshotLabel: 'Forger Desktop · real screenshot',
    },
    install: {
      eyebrow: 'Install it where you will create',
      title: 'Forger installs on your computer.',
      description: 'If you came from Instagram on your phone, send yourself this link. When you open it on your computer, it will keep the campaign attribution and show the right download.',
      phoneTitle: 'Are you on your phone?',
      phoneDescription: 'Send yourself this link however you prefer, then open it from your computer.',
      linkLabel: 'Forger download link',
      share: 'Share link',
      copy: 'Copy link',
      computerTitle: 'Already on your computer?',
      computerDescription: 'Choose a download. macOS Apple silicon is stable; macOS Intel, Windows, and Linux options are experimental.',
    },
    provider: {
      eyebrow: 'Use the AI you already know',
      title: 'You do not need another subscription.',
      description: 'Connect ChatGPT, Claude, or Antigravity with the account you already have. Forger prepares a space where you can turn a specific need into an app.',
      note: 'Forger does not replace your AI service: each provider keeps its own limits, terms, and possible costs. You choose the account and provider you want to use.',
      screenshotAlt: 'A real screenshot of the local catalog of apps available in Forger.',
      screenshotLabel: 'Explore apps inside Forger · real screenshot',
    },
    privacy: {
      eyebrow: 'Private by design',
      title: 'Your space, under your control.',
      description: 'Apps install and run in a local workspace on your computer. You decide which files to use and what to share.',
      localTitle: 'Local-first',
      localDescription: 'Installed apps live on your computer and must not read external files unless you share them.',
      sharingTitle: 'You choose what to share',
      sharingDescription: 'Cloud services are used only when you choose features that need them, such as an account, backup, or sharing.',
      screenshotAlt: 'A real screenshot of Forger showing apps installed on a person’s computer.',
      screenshotLabel: 'Your apps in Forger · real screenshot',
    },
    closing: {
      title: 'Create an app that actually helps you.',
      description: 'Free for people. Use the AI you already have. Keep your apps on your computer.',
      download: 'Download Forger free',
    },
    campaignPath: 'forger.cloud/instagram',
    shareTitle: 'Forger free for people',
    shareText: 'Create local apps with the AI you already use.',
    copied: 'Link copied. Open it from your computer to download Forger.',
    manualCopy: 'Select and copy this link to open it on your computer.',
    shared: 'Done: share the link and open it from your computer.',
    shareFallback: 'You can copy the link and send it to yourself however you prefer.',
  },
  es: {
    hero: {
      eyebrow: 'Gratis para personas',
      title: ['Tu IA. Tus apps.', 'Tu computador.'],
      description: 'Crea una app para tu vida o trabajo con la cuenta de IA que ya usas. Forger es gratis para personas y no cobra una suscripción adicional.',
      points: ['ChatGPT, Claude o Antigravity', 'Sin otro plan de Forger', 'Local por defecto'],
      download: 'Descargar Forger gratis',
      note: 'No pedimos tarjeta. Los límites, condiciones y posibles costos de tu proveedor de IA siguen aplicando según la cuenta que ya tienes.',
      screenshotAlt: 'Captura real de Forger Desktop mostrando una app local y el panel de conversación.',
      screenshotLabel: 'Forger Desktop · captura real',
    },
    install: {
      eyebrow: 'Instálalo donde crearás',
      title: 'Forger se instala en tu computador.',
      description: 'Si llegaste desde Instagram en tu teléfono, compártete este enlace. Al abrirlo en tu computador conservará la campaña y mostrará la descarga correcta.',
      phoneTitle: '¿Estás en tu teléfono?',
      phoneDescription: 'Envíate este enlace por el medio que prefieras y ábrelo desde tu computador.',
      linkLabel: 'Enlace de descarga de Forger',
      share: 'Compartir enlace',
      copy: 'Copiar enlace',
      computerTitle: '¿Ya estás en tu computador?',
      computerDescription: 'Elige una descarga. macOS Apple silicon es estable; las opciones para macOS Intel, Windows y Linux son experimentales.',
    },
    provider: {
      eyebrow: 'Usa la IA que ya conoces',
      title: 'No necesitas pagar otra suscripción.',
      description: 'Conecta ChatGPT, Claude o Antigravity con la cuenta que ya tienes. Forger prepara el espacio para que puedas transformar una necesidad concreta en una app.',
      note: 'Forger no reemplaza el servicio de IA: cada proveedor mantiene sus propios límites, condiciones y posibles costos. Tú eliges la cuenta y el proveedor que quieres usar.',
