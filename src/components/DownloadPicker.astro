---
import { ChevronDown, Download } from 'lucide-astro';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  compact?: boolean;
}

const { lang, compact = false } = Astro.props;

const copy = {
  en: {
    detecting: 'Checking your computer...',
    nav: 'Download',
    fallback: 'Download Forger',
    soon: 'Coming soon',
    other: 'Other downloads',
    macArm: 'Download for macOS Apple silicon',
    macIntelSoon: 'macOS Intel coming soon',
    windows: 'Download for Windows',
    unsupported: 'Coming soon for this computer',
    available: 'Available',
  },
  es: {
    detecting: 'Revisando tu computador...',
    nav: 'Descargar',
    fallback: 'Descargar Forger',
    soon: 'Pronto',
    other: 'Otras descargas',
    macArm: 'Descargar para macOS Apple silicon',
    macIntelSoon: 'macOS Intel pronto',
    windows: 'Descargar para Windows',
    unsupported: 'Pronto para este computador',
    available: 'Disponible',
  },
}[lang];

const macArmUrl = 'https://github.com/forger-ai/forger-desktop/releases/latest/download/forger-desktop-macos-arm64.dmg';
const windowsX64Url = 'https://github.com/forger-ai/forger-desktop/releases/latest/download/forger-desktop-windows-x64.exe';
---

<div
  class="download-picker relative z-[100] inline-flex items-stretch"
  data-lang={lang}
  data-mac-arm-url={macArmUrl}
  data-windows-x64-url={windowsX64Url}
  data-detecting={copy.detecting}
  data-compact={compact ? 'true' : 'false'}
  data-nav={copy.nav}
  data-fallback={copy.fallback}
  data-soon={copy.soon}
  data-mac-arm={copy.macArm}
  data-mac-intel-soon={copy.macIntelSoon}
  data-windows={copy.windows}
  data-unsupported={copy.unsupported}
>
  <a
    data-download-primary
    href={macArmUrl}
    class={`${compact ? 'px-4 py-1.5' : 'px-6 py-3'} inline-flex items-center justify-center gap-2 rounded-l-full bg-brand text-sm font-semibold text-white transition-colors hover:bg-brand-dark`}
  >
    <Download size={compact ? 15 : 17} />
    <span data-download-label>{copy.nav}</span>
  </a>

  <details class="group relative z-[90]" data-download-details>
    <summary
      class={`${compact ? 'h-8 w-9' : 'h-full w-12'} inline-flex cursor-pointer list-none items-center justify-center rounded-r-full border-l border-white/20 bg-brand text-white transition-colors hover:bg-brand-dark [&::-webkit-details-marker]:hidden`}
      aria-label={copy.other}
    >
      <ChevronDown size={compact ? 15 : 16} class="transition-transform group-open:rotate-180" />
    </summary>
    <div class="absolute right-0 z-[100] mt-2 w-72 overflow-hidden rounded-2xl border border-white/10 bg-[#1b2229] shadow-2xl shadow-black/60">
      <a href={windowsX64Url} class="block px-4 py-3 text-sm text-zinc-200 transition-colors hover:bg-white/[0.05]">
        <span class="block font-semibold">{copy.windows}</span>
        <span class="mt-1 block text-xs text-zinc-500">Windows x64 · Intel / AMD</span>
      </a>
      <a href={macArmUrl} class="block border-t border-white/10 px-4 py-3 text-sm text-zinc-200 transition-colors hover:bg-white/[0.05]">
        <span class="block font-semibold">{copy.macArm}</span>
        <span class="mt-1 block text-xs text-zinc-500">macOS arm64 · Apple silicon</span>
      </a>
      <div class="border-t border-white/10 px-4 py-3 text-sm text-zinc-500">
        <span class="block font-semibold text-zinc-400">{copy.macIntelSoon}</span>
        <span class="mt-1 block text-xs">macOS x64 · Intel</span>
      </div>
    </div>
  </details>
</div>

<script is:inline>
  (async () => {
  const downloadPickers = document.querySelectorAll('.download-picker');
  const downloadDetails = document.querySelectorAll('[data-download-details]');

  document.addEventListener('click', (event) => {
    for (const details of downloadDetails) {
      if (!details.contains(event.target)) details.removeAttribute('open');
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const details of downloadDetails) details.removeAttribute('open');
  });

  async function detectDownloadTarget() {
    const nav = window.navigator;
    const ua = nav.userAgent || '';
    const platform = nav.userAgentData?.platform || nav.platform || '';
    let architecture = '';

    if (nav.userAgentData?.getHighEntropyValues) {
      try {
        const values = await nav.userAgentData.getHighEntropyValues(['architecture']);
        architecture = values.architecture || '';
      } catch {
        architecture = '';
      }
    }

    const isWindows = /Windows/i.test(platform) || /Windows/i.test(ua);
    const isMac = /Mac/i.test(platform) || /Mac OS X/i.test(ua);
    const isArm = /arm|aarch64/i.test(architecture);
    const isIntel = /x86|x64|amd64/i.test(architecture);

    if (isWindows) return { kind: 'windows' };
    if (isMac && isIntel) return { kind: 'mac-intel' };
    if (isMac && isArm) return { kind: 'mac-arm' };
    if (isMac) return { kind: 'mac-arm' };
    return { kind: 'unsupported' };
  }

  function setUnsupported(link, label, text) {
    link.removeAttribute('href');
    link.setAttribute('aria-disabled', 'true');
    link.classList.add('cursor-not-allowed', 'bg-zinc-700', 'text-zinc-300', 'hover:bg-zinc-700');
    link.classList.remove('bg-brand', 'hover:bg-brand-dark');
    label.textContent = text;
  }

  const target = await detectDownloadTarget();
    for (const picker of downloadPickers) {
      const link = picker.querySelector('[data-download-primary]');
      const label = picker.querySelector('[data-download-label]');
      if (!link || !label) continue;

      if (target.kind === 'windows') {
        link.href = picker.dataset.windowsX64Url;
        label.textContent = picker.dataset.nav;
      } else if (target.kind === 'mac-arm') {
        link.href = picker.dataset.macArmUrl;
        label.textContent = picker.dataset.nav;
      } else if (target.kind === 'mac-intel') {
        setUnsupported(link, label, picker.dataset.macIntelSoon);
      } else {
        setUnsupported(link, label, picker.dataset.unsupported);
      }
    }
  })();
</script>
