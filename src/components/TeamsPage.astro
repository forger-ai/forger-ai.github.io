---
import {
  AppWindow,
  ArrowRight,
  Bot,
  CheckCircle2,
  Database,
  Files,
  MessageSquare,
  Rocket,
  Server,
  ShieldCheck,
  Sparkles,
  Workflow,
} from 'lucide-astro';
import TeamDemoRequestForm from './TeamDemoRequestForm.astro';
import { t, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = t(lang).teams;
const resourceIcons = [Server, Database, Files, ShieldCheck];
const promiseIcons = [AppWindow, Workflow, Bot];
const stepIcons = [MessageSquare, Sparkles, Rocket];
const capabilityIcons = [AppWindow, Server, Files, ShieldCheck];
---

<div class="overflow-hidden">
  <section class="relative px-6 pb-20 pt-28 sm:pt-32">
    <div class="orbital-field absolute inset-x-0 top-0 -z-10 h-[820px] opacity-70"></div>
    <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <div class="mb-6 flex flex-wrap gap-2">
          {content.hero.badges.map((badge) => (
            <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs font-medium text-zinc-300">{badge}</span>
          ))}
        </div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-brand">{content.hero.eyebrow}</p>
        <h1 class="mt-5 text-4xl font-bold leading-[1.05] tracking-tight text-white sm:text-6xl">
          {content.hero.title}
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-zinc-300">{content.hero.body}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#beta" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-brand px-6 py-3 font-semibold text-black transition hover:bg-brand-dark">
            {content.hero.primaryCta}
            <ArrowRight size={18} />
          </a>
          <a href="#how-it-works" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/15 bg-white/[0.03] px-6 py-3 font-semibold text-zinc-200 transition hover:border-white/30 hover:bg-white/[0.06]">
            {content.hero.secondaryCta}
          </a>
        </div>
        <p class="mt-5 text-sm text-zinc-500">{content.hero.note}</p>
      </div>

      <div class="relative">
        <div class="absolute inset-8 rounded-full bg-brand/15 blur-3xl"></div>
        <div class="relative rounded-[2rem] border border-white/10 bg-zinc-950/75 p-5 shadow-2xl shadow-black/30 sm:p-7">
          <div class="flex items-start justify-between gap-4 border-b border-white/10 pb-5">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand">{content.hero.workspace.eyebrow}</p>
              <h2 class="mt-2 text-xl font-semibold text-white">{content.hero.workspace.title}</h2>
            </div>
            <span class="rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-xs font-medium text-emerald-300">
              {content.hero.workspace.status}
            </span>
          </div>
          <div class="mt-4 grid gap-3">
            {content.hero.workspace.resources.map((resource, index) => {
              const Icon = resourceIcons[index];
              return (
                <div class="flex items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.035] p-4">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand"><Icon size={19} /></span>
                  <span class="min-w-0 flex-1 text-sm font-medium text-zinc-200">{resource.title}</span>
                  <span class="text-xs font-medium text-zinc-500">{resource.detail}</span>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">{content.promise.eyebrow}</p>
      <h2 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-5xl">{content.promise.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-zinc-400">{content.promise.body}</p>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {content.promise.items.map((item, index) => {
        const Icon = promiseIcons[index];
        return (
          <article class="rounded-[1.5rem] border border-white/10 bg-surface-raised/70 p-6">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand/10 text-brand"><Icon size={22} /></span>
            <h3 class="mt-6 text-xl font-semibold text-white">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-zinc-400">{item.body}</p>
          </article>
        );
      })}
    </div>
  </section>

  <section id="how-it-works" class="mx-auto max-w-6xl scroll-mt-24 px-6 py-20">
    <div class="rounded-[2rem] border border-white/10 bg-white/[0.025] p-6 sm:p-10">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">{content.how.eyebrow}</p>
        <h2 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl">{content.how.title}</h2>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-3">
        {content.how.steps.map((step, index) => {
          const Icon = stepIcons[index];
          return (
            <article class="relative rounded-[1.5rem] border border-white/10 bg-zinc-950/50 p-6">
              <div class="flex items-center justify-between">
                <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-brand/10 text-brand"><Icon size={20} /></span>
                <span class="font-mono text-xs text-zinc-600">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <h3 class="mt-7 text-lg font-semibold text-white">{step.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-zinc-400">{step.body}</p>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">{content.capabilities.eyebrow}</p>
      <h2 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-5xl">{content.capabilities.title}</h2>
      <p class="mt-5 text-lg leading-relaxed text-zinc-400">{content.capabilities.body}</p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {content.capabilities.cards.map((card, index) => {
        const Icon = capabilityIcons[index];
        return (
          <article class="flex gap-5 rounded-[1.5rem] border border-white/10 bg-surface-raised/70 p-6">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-brand/10 text-brand"><Icon size={20} /></span>
            <div>
              <h3 class="text-lg font-semibold text-white">{card.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-zinc-400">{card.body}</p>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="grid gap-10 rounded-[2rem] border border-brand/20 bg-brand/[0.055] p-6 sm:p-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">{content.provider.eyebrow}</p>
        <h2 class="mt-4 text-3xl font-bold leading-tight text-white sm:text-4xl">{content.provider.title}</h2>
        <p class="mt-5 text-lg leading-relaxed text-zinc-300">{content.provider.body}</p>
      </div>
      <ul class="space-y-3">
        {content.provider.points.map((point) => (
          <li class="flex gap-3 rounded-2xl border border-white/10 bg-zinc-950/45 p-4 text-sm leading-relaxed text-zinc-300">
            <CheckCircle2 class="mt-0.5 shrink-0 text-brand" size={18} />
            <span>{point}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <TeamDemoRequestForm lang={lang} />
</div>
