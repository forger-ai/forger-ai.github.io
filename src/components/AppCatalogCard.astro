---
import { ArrowRight } from 'lucide-astro';
import type { AppEntry } from '../data/apps';
import { localePath, type Lang } from '../i18n/utils';

interface Props {
  app: AppEntry;
  lang: Lang;
  cta: string;
  statusLabel: string;
}

const { app, lang, cta, statusLabel } = Astro.props;
---

<a
  href={localePath(lang, `/apps/${app.slug}`)}
  class={`group block rounded-[1.5rem] border border-white/10 bg-gradient-to-br ${app.accent} p-6 transition duration-300 hover:-translate-y-1 hover:border-brand/50 hover:shadow-2xl hover:shadow-black/30`}
>
  <div class="mb-12 flex items-start justify-between">
    <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-zinc-950/80 text-2xl font-bold text-brand">ƒ</div>
    <span class="rounded-full border border-emerald-300/20 bg-emerald-300/10 px-3 py-1 text-xs font-medium text-emerald-100">
      {statusLabel}
    </span>
  </div>
  <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand">{app.category[lang]}</p>
  <h3 class="mt-3 text-2xl font-semibold text-white">{app.name}</h3>
  <p class="mt-3 max-w-xl text-sm leading-relaxed text-zinc-300">{app.highlight[lang]}</p>
  <div class="mt-6 flex flex-wrap gap-2">
    {app.tags[lang].map((tag) => (
      <span class="rounded-full border border-white/10 bg-zinc-950/35 px-3 py-1 text-xs text-zinc-300">{tag}</span>
    ))}
  </div>
  <div class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-white transition-colors group-hover:text-brand">
    {cta}
    <ArrowRight size={16} />
  </div>
</a>
