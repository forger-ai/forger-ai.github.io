---
import '../styles/global.css';
import DownloadPicker from '../components/DownloadPicker.astro';
import { getLang, t, localePath, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: Lang;
}

const {
  title,
  description = 'Forger — Build and run local AI-powered apps, no cloud required.',
  ogImage = '/og.png',
  lang: langProp,
} = Astro.props;

const lang: Lang = langProp ?? getLang(Astro.url);
const i18n = t(lang);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const altLang: Lang = lang === 'en' ? 'es' : 'en';
const altPath = altLang === 'es'
  ? `/es${Astro.url.pathname}`
  : Astro.url.pathname.replace(/^\/es/, '') || '/';
const githubUrl = 'https://github.com/forger-ai';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={altLang} href={new URL(altPath, Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    <meta name="google" content="notranslate" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@300;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-surface-base text-zinc-100 font-sans antialiased">
    <header class="fixed top-0 inset-x-0 z-50 border-b border-white/5 bg-surface-base/80 backdrop-blur-md">
      <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href={localePath(lang, '/')} class="flex items-center gap-2.5" translate="no">
          <img src="/icon-dark.svg" alt="Forger" class="w-9 h-9 notranslate" translate="no" />
          <span class="notranslate text-white text-xl font-light" style="font-family: 'Poppins', sans-serif; letter-spacing: 0.35em;" translate="no">FORGER</span>
        </a>
        <div class="flex items-center gap-5 text-sm text-zinc-400">
          <a href={`${localePath(lang, '/')}#how`} class="hover:text-white transition-colors hidden sm:block">{i18n.nav.how}</a>
          <a href={`${localePath(lang, '/')}#agents`} class="hover:text-white transition-colors hidden sm:block">{i18n.nav.agents}</a>
          <a href={`${localePath(lang, '/')}#social`} class="hover:text-white transition-colors hidden md:block">{i18n.nav.social}</a>
          <a href={`${localePath(lang, '/')}#privacy`} class="hover:text-white transition-colors hidden md:block">{i18n.nav.privacy}</a>
          <a href={`${localePath(lang, '/')}#teams`} class="hover:text-white transition-colors hidden lg:block">{i18n.nav.teams}</a>
          <a href={localePath(lang, '/docs')} class="hover:text-white transition-colors hidden lg:block">{i18n.nav.docs}</a>
          <a href={localePath(lang, '/blog')} class="hover:text-white transition-colors hidden lg:block">{i18n.nav.blog}</a>
          <a
            href={altPath}
            class="text-zinc-500 hover:text-zinc-300 transition-colors font-mono text-xs tracking-widest uppercase"
            title={altLang === 'es' ? 'Español' : 'English'}
          >
            {altLang === 'es' ? 'ES' : 'EN'}
          </a>
          <div class="hidden sm:inline-flex">
            <DownloadPicker lang={lang} compact />
          </div>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="border-t border-white/5 mt-24 py-10 text-center text-zinc-500 text-sm">
      <div class="flex flex-col items-center gap-3">
        <p class="text-zinc-400">
          {i18n.footer.contact}{' '}
          <a href="mailto:hello@forger.cloud" class="font-medium text-brand transition-colors hover:text-brand-dark">hello@forger.cloud</a>
        </p>
        <p>© {new Date().getFullYear()} <span style="font-family: 'Poppins', sans-serif; letter-spacing: 0.25em;" class="notranslate font-semibold text-zinc-400" translate="no">FORGER</span>. {i18n.footer.rights}</p>
        <div class="flex items-center gap-4">
          <a href={localePath(lang, '/privacy')} class="hover:text-zinc-300 transition-colors">{i18n.footer.privacy}</a>
          <a href={localePath(lang, '/terms')} class="hover:text-zinc-300 transition-colors">{i18n.footer.terms}</a>
          <a href={githubUrl} class="hover:text-zinc-300 transition-colors">{i18n.footer.github}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
