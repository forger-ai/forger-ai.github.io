---
import { ArrowLeft, BarChart3, FolderTree, ListChecks, MessageSquare, ShieldCheck, Upload } from 'lucide-astro';
import BaseLayout from './BaseLayout.astro';
import ChatDemo from '../components/ChatDemo.astro';
import DownloadPicker from '../components/DownloadPicker.astro';
import type { AppEntry } from '../data/apps';
import { localePath, type Lang } from '../i18n/utils';

interface Props {
  app: AppEntry;
  lang: Lang;
}

const { app, lang } = Astro.props;
const content = app.landing[lang];
const flowIcons = [FolderTree, Upload, ListChecks, BarChart3, MessageSquare];
const description = `${content.subtitle} ${content.body}`;
const proof = {
  en: {
    screenshotAlt: 'Finance OS dashboard showing spending cards, budgets, and a category breakdown.',
  },
  es: {
    screenshotAlt: 'Dashboard de Finance OS mostrando tarjetas de gasto, presupuestos y desglose por categoría.',
  },
}[lang];
---

<BaseLayout title={`Forger — ${app.name}`} description={description} lang={lang}>
  <div class="overflow-hidden">
    <section class="relative px-6 pb-16 pt-32 sm:pt-36">
      <div class="orbital-field absolute inset-x-0 top-0 -z-10 h-[680px] opacity-70"></div>
      <div class="mx-auto grid max-w-6xl gap-10 lg:min-h-[660px] lg:grid-cols-[0.82fr_1.18fr] lg:items-center">
        <div>
          <a href={`${localePath(lang, '/')}#apps`} class="mb-8 inline-flex items-center gap-2 text-sm text-zinc-500 transition-colors hover:text-zinc-300">
            <ArrowLeft size={16} />
            {content.ctaSecondary}
          </a>
          <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand">{content.eyebrow}</p>
          <h1 class="mt-4 text-5xl font-bold leading-tight text-white sm:text-7xl">{content.title}</h1>
          <p class="mt-5 max-w-2xl text-xl leading-relaxed text-zinc-300">{content.subtitle}</p>
          <p class="mt-5 max-w-2xl leading-relaxed text-zinc-400">{content.body}</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <DownloadPicker lang={lang} />
            <a href={`${localePath(lang, '/')}#apps`} class="inline-flex items-center justify-center gap-2 rounded-full border border-white/10 bg-white/[0.035] px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-brand/40">
              {content.ctaSecondary}
            </a>
          </div>
        </div>
        <div>
          <img
            src="/assets/screenshots/finance-os-dashboard.png"
            alt={proof.screenshotAlt}
            loading="eager"
            decoding="async"
            class="block w-full rounded-[1.25rem] shadow-2xl shadow-black/35"
          />
        </div>
      </div>
      <div class="mx-auto mt-10 max-w-4xl">
        <ChatDemo lang={lang} />
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="max-w-3xl">
        <h2 class="text-3xl font-bold leading-tight text-white sm:text-4xl">{content.flowTitle}</h2>
        <p class="mt-4 leading-relaxed text-zinc-400">{content.flowSubtitle}</p>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
        {content.flow.map((step, index) => {
          const Icon = flowIcons[index];
          return (
            <div class="rounded-[1.5rem] border border-white/10 bg-surface-raised/70 p-6">
              <div class="mb-8 flex h-12 w-12 items-center justify-center rounded-2xl bg-brand/10 text-brand">
                <Icon size={22} />
              </div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-zinc-500">{String(index + 1).padStart(2, '0')}</p>
              <h3 class="mt-2 text-xl font-semibold text-white">{step.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-zinc-400">{step.body}</p>
            </div>
          );
        })}
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
        <div>
          <h2 class="text-3xl font-bold leading-tight text-white sm:text-4xl">{content.featuresTitle}</h2>
          <p class="mt-4 leading-relaxed text-zinc-400">{app.highlight[lang]}</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {content.features.map((feature) => (
            <div class="rounded-[1.35rem] border border-white/10 bg-surface-raised/70 p-5">
              <h3 class="font-semibold text-white">{feature.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-zinc-400">{feature.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="grid gap-8 rounded-[2rem] border border-brand/20 bg-brand/5 p-6 sm:p-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
        <div>
          <ShieldCheck class="text-brand" size={28} />
          <h2 class="mt-5 text-3xl font-bold leading-tight text-white sm:text-4xl">{content.privacyTitle}</h2>
          <p class="mt-4 leading-relaxed text-zinc-300">{content.privacyBody}</p>
        </div>
        <div class="rounded-[1.5rem] border border-white/10 bg-zinc-950/50 p-6">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand">{app.name}</p>
          <h3 class="mt-3 text-2xl font-semibold text-white">{content.ctaTitle}</h3>
          <p class="mt-3 leading-relaxed text-zinc-400">{content.ctaBody}</p>
          <div class="mt-7">
            <DownloadPicker lang={lang} />
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
