---
import { getCollection } from 'astro:content';
import HomePage from '../components/HomePage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const lang = 'en';
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === lang))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="Forger — The app store from the future"
  description="Open, private, AI-powered apps that run locally on your computer."
  lang={lang}
>
  <HomePage lang={lang} posts={posts} />
</BaseLayout>
