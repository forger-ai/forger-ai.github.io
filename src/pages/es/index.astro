---
import { getCollection } from 'astro:content';
import HomePage from '../../components/HomePage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'es';
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === lang))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="Forger — La app store del futuro"
  description="Apps abiertas, privadas y potenciadas por IA que corren localmente en tu computador."
  lang={lang}
>
  <HomePage lang={lang} posts={posts} />
</BaseLayout>
