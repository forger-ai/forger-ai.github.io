---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { t } from '../../../i18n/utils';

const lang = 'es';
const i18n = t(lang);

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'es'))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title="Blog — Forger" description={i18n.blog.subtitle} lang={lang}>
  <div class="max-w-2xl mx-auto px-6 pt-32 pb-24">
    <h1 class="text-3xl font-bold text-white">{i18n.blog.title}</h1>
    <p class="mt-2 text-zinc-400">{i18n.blog.subtitle}</p>

    <ul class="mt-12 space-y-10">
      {posts.map((post) => (
        <li>
          <a href={`/es/blog/${post.id.replace(/^es\//, '')}`} class="group block">
            <time class="text-xs text-zinc-500">
              {post.data.pubDate.toLocaleDateString('es-CL', { month: 'long', day: 'numeric', year: 'numeric' })}
            </time>
            <h2 class="mt-1 text-xl font-semibold text-white group-hover:text-brand transition-colors">
              {post.data.title}
            </h2>
            <p class="mt-2 text-sm text-zinc-400">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>

    {posts.length === 0 && (
      <p class="mt-12 text-zinc-500">{i18n.blog.empty}</p>
    )}
  </div>
</BaseLayout>
